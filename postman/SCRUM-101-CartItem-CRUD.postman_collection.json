    {
      "name": "1. Create CartItem",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('productId matches', () => pm.expect(body.productId).to.eql(parseInt(pm.collectionVariables.get('productId'))));",
              "if (pm.response.code >= 200 && pm.response.code < 300 && body && body.id) {",
              "    pm.collectionVariables.set('cartItemId', body.id);",
              "} else {",
              "    console.error('Failed to capture cartItemId - response: ' + JSON.stringify(body));",
              "    pm.test('cartItemId captured from response', () => pm.expect.fail('This request did not return a valid id, so downstream requests will fail. Check the response body above.'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cartId\": {{cartId}},\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/carts/{{cartId}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "{{cartId}}",
            "items"
          ]
        }
      }
    },
