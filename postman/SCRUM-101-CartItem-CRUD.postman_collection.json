{
  "info": {
    "_postman_id": "8f3a1e10-7701-4a11-9c77-000000000101",
    "name": "SCRUM-101 - CartItem CRUD",
    "description": "As a user, I want to create, view, list, update, and delete CartItem records linked to a Cart and a Product, so that a cart can contain multiple line items instead of a single product/quantity pair.\n\nBranch: brownfield/scrum-101-as-a-user-i-want-to-create-view-list-upd (requires SCRUM-133 merged for Cart creation)\nBase path: /carts/{cartId}/items\n\nCart is now created via POST /carts (see Setup > 0c) - the previously required manual H2-console insert is no longer needed now that SCRUM-133 (Cart CRUD) is implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "cartId",
      "value": ""
    },
    {
      "key": "cartItemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0a. Create Category (dependency)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && body && body.id) {",
                  "    pm.collectionVariables.set('categoryId', body.id);",
                  "} else {",
                  "    console.error('Failed to capture categoryId - response: ' + JSON.stringify(body));",
                  "    pm.test('categoryId captured from response', () => pm.expect.fail('This request did not return a valid id, so downstream requests will fail. Check the response body above.'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keyboards\",\n  \"description\": \"Keyboard category\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
        {
