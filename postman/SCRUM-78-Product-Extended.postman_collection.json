{
  "info": {
    "_postman_id": "8f3a1e10-7701-4a11-9c77-000000000078",
    "name": "SCRUM-78 - Product Extended (categoryId + description)",
    "description": "As a system, I want Product extended with a categoryId relation and description, so that products can be classified and described in more detail.\n\nBranch: brownfield/scrum-78-as-a-system-i-want-product-extended-with (requires SCRUM-134 merged for duplicate-sku handling)\nBase path: /api/products (categoryId and description are now required fields)\n\nSCRUM-134: duplicate sku on create or update now returns 409 Conflict instead of an unhandled 500.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "secondProductId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0. Create Category (dependency)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && body && body.id) {",
                  "    pm.collectionVariables.set('categoryId', body.id);",
                  "} else {",
                  "    console.error('Failed to capture categoryId - response: ' + JSON.stringify(body));",
                  "    pm.test('categoryId captured from response', () => pm.expect.fail('This request did not return a valid id, so downstream requests will fail. Check the response body above.'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Peripherals\",\n  \"description\": \"Peripheral devices\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Create Product (with categoryId + description)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('categoryId present in response', () => pm.expect(body.categoryId).to.eql(parseInt(pm.collectionVariables.get('categoryId'))));",
              "pm.test('description present in response', () => pm.expect(body.description).to.eql('A wireless mouse'));",
              "if (pm.response.code >= 200 && pm.response.code < 300 && body && body.id) {",
              "    pm.collectionVariables.set('productId', body.id);",
              "} else {",
              "    console.error('Failed to capture productId - response: ' + JSON.stringify(body));",
              "    pm.test('productId captured from response', () => pm.expect.fail('This request did not return a valid id, so downstream requests will fail. Check the response body above.'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"sku\": \"SKU-001\",\n  \"price\": 19.99,\n  \"stock\": 100,\n  \"status\": \"ACTIVE\",\n  \"categoryId\": {{categoryId}},\n  \"description\": \"A wireless mouse\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
