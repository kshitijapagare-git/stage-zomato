            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('sku matches', () => pm.expect(pm.response.json().sku).to.eql('SKU-001'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
